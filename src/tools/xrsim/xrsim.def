; The loader looks up "xrNegotiateLoaderRuntimeInterface" by its UNDECORATED
; name. XRAPI_CALL is __stdcall, so on Win32 a plain __declspec(dllexport) would
; publish it as _xrNegotiateLoaderRuntimeInterface@8 and the loader would report
; "failed to find negotiate function". A .def file is what pins the exact name -
; the same reason src/proxy/xinput_proxy.def exists.
LIBRARY bvr_xrsim32
EXPORTS
    xrNegotiateLoaderRuntimeInterface
